{
  "name": "tcplab-extension",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "TCPLab browser extension: inspect the current public page's DNS, WHOIS and TLS information.",
  "packageManager": "pnpm@9.12.2",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "postinstall": "wxt prepare"
  },
  "dependencies": {
    "@nuxt/ui": "^4.12.0",
    "ipaddr.js": "^2.5.0",
    "tailwindcss": "^4.3.3",
    "vue": "^3.5.44"
  },
  "devDependencies": {
    "@iconify-json/lucide": "^1.2.146",
    "@wxt-dev/module-vue": "^1.0.3",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5",
    "vue-tsc": "^3.3.13",
    "web-ext": "^10.8.0",
    "wxt": "^0.21.4"
  }
}
